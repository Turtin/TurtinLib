{
  "schemaVersion": 1,
  "id": "turtinlib",
  "version": "${version}",
  "name": "Turtin Lib",
  "description": "A library made by Turtin for various implementations",
  "authors": ["Turtin"],
  "contact": {},
  "license": "GNU GENERAL PUBLIC LICENSE",
  "icon": "assets/turtinlib/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.turtin.turtinlib.client.TurtinlibClient"
    ],
    "main": [
      "dev.turtin.turtinlib.Turtinlib"
    ],
    "modmenu": [
      "dev.turtin.turtinlib.client.modmenu.TurtinlibModMenuImpl"
    ]
  },
  "mixins": [
    "turtinlib.mixins.json",
    {
      "config": "turtinlib.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.wiki": "https://github.com/Turtin/TurtinLib",
        "modmenu.github_releases": "https://github.com/Turtin/TurtinLib/releases"
      },
      "badges": [ "library" ]
    }
  }
}
